                                    "updateTraceId": "string",
                                    "uploadDetailId": 0,
                                    "uploadId": 0,
                                    "organizationId": 0,
                                    "ingestionFlowFileId": 0,
                                    "ingestionFlowFileType": "RECEIPT",
                                    "filePathName": "string",
                                    "fileName": "string",
                                    "fileSize": 0,
                                    "status": "UPLOADED",
                                    "errorDescription": "string",
                                    "discardFileName": "string",
                                    "numTotalRows": 0,
                                    "numCorrectlyImportedRows": 0
                                }
