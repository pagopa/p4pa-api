                    },
                    "500": {
                        "description": "Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorDTO"
                                },
                                "example": {
                                    "code": "NOT_FOUND",
                                    "message": "string",
                                    "traceId": "string"
                                }
                            }
                        }
                    }
                }
