{
    "openapi": "3.0.1",
    "info": {
        "title": "Migration API",
        "description": "Servizio migration per Piattaforma Unitaria",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "https://api.p4pa.pagopa.it/pu/migration"
        }
    ],
    "paths": {
        "/organization/{orgIpaCode}/{migrationFileType}": {
            "post": {
                "tags": [
                    "migration-file"
                ],
                "summary": "uploadMigrationFlowFile",
                "description": "Service to store an migration file",
                "operationId": "uploadMigrationFile",
                "parameters": [
                    {
                        "name": "orgIpaCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "migrationFileType",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/MigrationFileTypeEnum"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "migrationFile"
                                ],
                                "properties": {
                                    "migrationFile": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UploadMigrationFileResponseDTO"
                                },
                                "example": {
                                    "uploadId": 0,
                                    "workflowId": "string",
                                    "runId": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorDTO"
                                },
                                "example": {
                                    "code": "NOT_FOUND",
                                    "message": "string",
                                    "traceId": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/organization/{orgIpaCode}": {
            "get": {
                "tags": [
                    "migration-file"
                ],
                "summary": "getMigrationFlows",
                "description": "Service to retrieve upload request statuses",
                "operationId": "getMigrationUploads",
                "parameters": [
                    {
                        "name": "orgIpaCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "migrationFileType",
                        "in": "query",
                        "schema": {
                            "$ref": "#/components/schemas/MigrationFileTypeEnum"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "$ref": "#/components/schemas/UploadsStatusEnum"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Uploads"
                                    }
                                },
                                "example": [
                                    {
                                        "creationDate": "string",
                                        "updateDate": "string",
                                        "updateOperatorExternalId": "string",
                                        "updateTraceId": "string",
                                        "uploadId": 0,
                                        "organizationId": 0,
                                        "filePathName": "string",
                                        "fileName": "string",
                                        "fileSize": 0,
                                        "fileType": "ORGANIZATIONS",
                                        "status": "UPLOADED",
                                        "errorDescription": "string",
                                        "numTotalFiles": 0,
                                        "numCorrectlyProcessedFiles": 0
                                    }
                                ]
                            }
                        }
                    },
                    "500": {
                        "description": "Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorDTO"
                                },
                                "example": {
                                    "code": "NOT_FOUND",
                                    "message": "string",
                                    "traceId": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/organization/{orgIpaCode}/migrations/{uploadId}": {
            "get": {
                "tags": [
                    "migration-file"
                ],
                "summary": "getMigrationFlow",
                "description": "Service to retrieve an upload request",
                "operationId": "getMigrationUpload",
                "parameters": [
                    {
                        "name": "orgIpaCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "uploadId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Uploads"
                                },
                                "example": {
                                    "creationDate": "string",
                                    "updateDate": "string",
                                    "updateOperatorExternalId": "string",
                                    "updateTraceId": "string",
                                    "uploadId": 0,
                                    "organizationId": 0,
                                    "filePathName": "string",
                                    "fileName": "string",
                                    "fileSize": 0,
                                    "fileType": "ORGANIZATIONS",
                                    "status": "UPLOADED",
                                    "errorDescription": "string",
                                    "numTotalFiles": 0,
                                    "numCorrectlyProcessedFiles": 0
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Server Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorDTO"
                                },
                                "example": {
                                    "code": "NOT_FOUND",
                                    "message": "string",
                                    "traceId": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/organization/{orgIpaCode}/migrations/{uploadId}/errors": {
            "get": {
                "tags": [
                    "migration-file"
                ],
                "summary": "getMigrationErrors",
                "description": "Service to retrieve errors on an upload request",
                "operationId": "getMigrationErrors",
                "parameters": [
                    {
                        "name": "orgIpaCode",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "uploadId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ZIP file containing error files",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                },
                                "examples": {
                                    "default": {
                                        "value": null
                                    }
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "No Content - No Errors Found",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                },
                                "examples": {
                                    "default": {
                                        "value": null
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized - Missing or invalid token",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                },
                                "examples": {
                                    "default": {
                                        "value": null
                                    }
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden - No upload in error state",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                },
                                "examples": {
                                    "default": {
                                        "value": null
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found - Upload not found",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                },
                                "examples": {
                                    "default": {
                                        "value": null
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error - Error during errors processing",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                },
                                "examples": {
                                    "default": {
                                        "value": null
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
