    "components": {
        "schemas": {
            "UploadMigrationFileResponseDTO": {
                "required": [
                    "runId",
                    "uploadId",
                    "workflowId"
                ],
                "type": "object",
                "properties": {
                    "uploadId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "workflowId": {
                        "type": "string"
                    },
                    "runId": {
                        "type": "string"
                    }
                }
            },
            "CodeEnum": {
                "enum": [
                    "NOT_FOUND",
                    "BAD_REQUEST",
                    "GENERIC_ERROR",
                    "FILE_UPLOAD_ERROR",
                    "INVALID_FILE",
                    "FORBIDDEN"
                ],
                "type": "string"
            },
            "ErrorDTO": {
                "required": [
                    "code",
                    "message"
                ],
                "type": "object",
                "properties": {
                    "code": {
                        "$ref": "#/components/schemas/CodeEnum"
                    },
                    "message": {
                        "type": "string"
                    },
                    "traceId": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "MigrationFileTypeEnum": {
                "enum": [
                    "ORGANIZATIONS",
                    "ORG_SIL_SERVICES",
                    "DEBT_POSITIONS_TYPE",
                    "DEBT_POSITIONS_TYPE_ORG",
                    "DEBT_POSITIONS_TYPE_ORG_OPERATORS",
                    "PAYMENT_NOTIFICATION",
                    "PAYMENTS_REPORTING",
                    "TREASURY_CSV_COMPLETE",
                    "ASSESSMENTS",
                    "ASSESSMENTS_REGISTRY",
                    "DEBT_POSITIONS",
                    "DEBT_POSITIONS_PAID"
                ],
                "type": "string"
            },
            "Uploads": {
                "required": [
                    "fileName",
                    "filePathName",
                    "fileSize",
                    "fileType",
                    "organizationId",
                    "status"
