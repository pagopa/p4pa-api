                    },
                    "updateOperatorExternalId": {
                        "type": "string"
                    },
                    "updateTraceId": {
                        "type": "string"
                    },
                    "uploadId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "organizationId": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "filePathName": {
                        "type": "string"
                    },
                    "fileName": {
                        "type": "string"
                    },
                    "fileSize": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "fileType": {
                        "$ref": "#/components/schemas/MigrationFileTypeEnum"
                    },
                    "status": {
                        "$ref": "#/components/schemas/UploadsStatusEnum"
                    },
                    "errorDescription": {
                        "type": "string"
                    },
                    "numTotalFiles": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "numCorrectlyProcessedFiles": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "UploadsStatusEnum": {
                "enum": [
                    "UPLOADED",
                    "PROCESSING",
                    "COMPLETED",
                    "ERROR"
                ],
                "type": "string"
            },
            "IngestionFlowFileStatus": {
                "enum": [
                    "UPLOADED",
                    "PROCESSING",
                    "COMPLETED",
                    "ERROR",
                    "WAITING_FILE",
                    "WARNING"
                ],
                "type": "string"
            },
            "IngestionFlowFileTypeEnum": {
                "enum": [
                    "RECEIPT",
                    "RECEIPT_PAGOPA",
                    "PAYMENTS_REPORTING",
                    "PAYMENTS_REPORTING_PAGOPA",
                    "TREASURY_OPI",
                    "TREASURY_CSV",
                    "TREASURY_XLS",
                    "TREASURY_POSTE",
                    "TREASURY_CSV_COMPLETE",
                    "DP_INSTALLMENTS",
                    "PAYMENT_NOTIFICATION",
